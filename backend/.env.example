# --- EcoChallenge backend environment ---
# Copy to .env (`cp .env.example .env`) and fill in the blanks. Never commit .env.
ENVIRONMENT=development

# Signing key for JWT access tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string

# SQLite file. The directory is created on first migration.
DATABASE_URL=sqlite:///./data/ecochallenge.db
# Production: use Turso (hosted libSQL) instead of a local file. Requires both settings.
# DATABASE_URL=libsql://<database>-<org>.turso.io
# TURSO_AUTH_TOKEN=

# Comma-separated origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Photo verification ---
# "gemini" = live Gemini/Gemma, "openai" = OpenAI-compatible / Cloudflare Workers AI, "mock" = offline.
VISION_PROVIDER=gemini
# Google Gemini settings:
GEMINI_API_KEY=
GEMINI_MODEL=gemma-4-26b-a4b-it
# OpenAI-compatible / Cloudflare Workers AI settings (used when VISION_PROVIDER=openai):
OPENAI_BASE_URL=https://api.cloudflare.com/client/v4/accounts/<account_id>/ai/v1
OPENAI_API_KEY=
OPENAI_MODEL=@cf/meta/llama-3.2-11b-vision-instruct
VISION_TIMEOUT_SECONDS=30

# --- Browser session cookies ---
# The frontend logs in with httpOnly cookies + a readable CSRF cookie.
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=
# COOKIE_SECURE=false   # unset = true in production, false in development

# --- Uploads ---
MAX_UPLOAD_MB=6
UPLOADS_DIR=./uploads

# --- Photo storage ---
# "local" = UPLOADS_DIR on disk (development). "r2" = Cloudflare R2 (production: Cloud Run's
# disk is ephemeral). Photos are always private; the API streams them after an ownership check.
STORAGE_BACKEND=local
# Required only when STORAGE_BACKEND=r2. Create an R2 API token with Object Read & Write.
# R2_ACCOUNT_ID=
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
