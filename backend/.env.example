# --- EcoChallenge backend environment ---
# Copy to .env (`cp .env.example .env`) and fill in the blanks. Never commit .env.
ENVIRONMENT=development

# Signing key for JWT access tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string

# SQLite file. The directory is created on first migration.
DATABASE_URL=sqlite:///./data/ecochallenge.db

# Comma-separated origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Photo verification ---
# "gemini" = live AI verification, "mock" = offline deterministic results (no key needed).
VISION_PROVIDER=gemini
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
VISION_TIMEOUT_SECONDS=30

# --- Uploads ---
MAX_UPLOAD_MB=6
UPLOADS_DIR=./uploads
